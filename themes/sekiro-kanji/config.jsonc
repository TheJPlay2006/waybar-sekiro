{
  "reload_style_on_change": true,
  "layer": "top",
  "position": "top",
  "height": 34,
  "spacing": 6,
  "margin-top": 5,
  "margin-left": 10,
  "margin-right": 10,

  // Modules layout
  "modules-left": [
    "custom/sekiro-logo",
    "hyprland/workspaces",
    "niri/workspaces",
    "sway/workspaces",
    "custom/media"
  ],
  "modules-center": [
    "hyprland/window",
    "niri/window",
    "sway/window"
  ],
  "modules-right": [
    "tray",
    "network",
    "pulseaudio",
    "cpu",
    "memory",
    "battery",
    "clock"
  ],

  // Sekiro Emblem / App Launcher (Torii Gate & Sakura Petals)
  "custom/sekiro-logo": {
    "format": "⛩  隻狼 🌸",
    "tooltip-format": "隻狼: SHADOWS DIE TWICE\n「迷えば、敗れる」 (Hesitation is defeat)\n\nClick: Open Launcher\nRight Click: Power Menu",
    "on-click": "rofi -show drun 2>/dev/null || wofi --show drun 2>/dev/null || fuzzel 2>/dev/null || noctalia msg panel-toggle launcher 2>/dev/null || alacritty",
    "on-click-right": "wlogout 2>/dev/null || noctalia msg panel-toggle session 2>/dev/null"
  },

  // Hyprland Workspaces (Traditional Kanji Numerals)
  "hyprland/workspaces": {
    "on-click": "activate",
    "all-outputs": true,
    "format": "{icon}",
    "format-icons": {
      "1": "一",
      "2": "二",
      "3": "三",
      "4": "四",
      "5": "五",
      "6": "六",
      "7": "七",
      "8": "八",
      "9": "九",
      "10": "十",
      "urgent": "危",
      "active": "斬",
      "default": "一"
    },
    "persistent-workspaces": {
      "*": [1, 2, 3, 4, 5]
    }
  },

  // Niri Workspaces (Kanji Numerals)
  "niri/workspaces": {
    "format": "{icon}",
    "format-icons": {
      "1": "一",
      "2": "二",
      "3": "三",
      "4": "四",
      "5": "五",
      "6": "六",
      "7": "七",
      "8": "八",
      "9": "九",
      "10": "十",
      "active": "斬",
      "default": "一"
    }
  },

  // Sway Workspaces (Kanji)
  "sway/workspaces": {
    "disable-scroll": true,
    "all-outputs": true,
    "format": "{icon}",
    "format-icons": {
      "1": "一",
      "2": "二",
      "3": "三",
      "4": "四",
      "5": "五",
      "focused": "斬",
      "urgent": "危",
      "default": "一"
    }
  },

  // Active Window Title (Japanese Calligraphy Brackets)
  "hyprland/window": {
    "format": "⚔ 『 {} 』",
    "max-length": 38,
    "separate-outputs": true
  },
  "niri/window": {
    "format": "⚔ 『 {} 』",
    "max-length": 38,
    "separate-outputs": true
  },
  "sway/window": {
    "format": "⚔ 『 {} 』",
    "max-length": 38
  },

  // Media Player (MPRIS)
  "custom/media": {
    "exec": "$HOME/.config/waybar/scripts/mediaplayer.sh",
    "return-type": "json",
    "format": "{}",
    "on-click": "playerctl play-pause 2>/dev/null",
    "on-click-right": "playerctl next 2>/dev/null",
    "on-click-middle": "playerctl previous 2>/dev/null",
    "interval": 2
  },

  // System Tray
  "tray": {
    "icon-size": 15,
    "spacing": 8
  },

  // Network (Spirit Connection)
  "network": {
    "format-wifi": "󰤨  {essid}",
    "format-ethernet": "󰀂  有線",
    "format-disconnected": "󰤮  断絶",
    "tooltip-format": "{ifname}: {ipaddr}/{cidr}",
    "tooltip-format-wifi": "{essid} ({signalStrength}%)\n⇣ {bandwidthDownBytes}  ⇡ {bandwidthUpBytes}",
    "interval": 5,
    "on-click": "noctalia msg panel-toggle control-center 2>/dev/null"
  },

  // Audio (Posture Gauge / 姿勢)
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "  沈黙",
    "format-icons": {
      "default": ["", "", ""]
    },
    "scroll-step": 5,
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle 2>/dev/null || pamixer -t 2>/dev/null",
    "on-click-right": "pavucontrol 2>/dev/null",
    "tooltip-format": "Posture / Sound: {volume}%"
  },

  // CPU (Vitality Meter / 体力)
  "cpu": {
    "interval": 3,
    "format": "󰍛 {usage}%",
    "tooltip-format": "Vitality (CPU): {usage}%"
  },

  // Memory (Spirit Emblems / 形代)
  "memory": {
    "interval": 5,
    "format": "󰘚 {percentage}%",
    "tooltip-format": "Spirit Emblems (RAM): {used:0.1f}GiB / {total:0.1f}GiB"
  },

  // Battery (Resurrection Nodes / 回生)
  "battery": {
    "states": {
      "good": 95,
      "warning": 30,
      "critical": 15
    },
    "format": "回生 {icon} {capacity}%",
    "format-charging": "覚醒 󰢝 {capacity}%",
    "format-plugged": "誓約  {capacity}%",
    "format-icons": ["󰂃", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
    "tooltip-format": "Resurrection Power (回生): {capacity}%\n{timeTo}"
  },

  // Clock (Sanctuary Bell / 鐘)
  "clock": {
    "format": "  {:%I:%M %p}",
    "format-alt": "🌸  {:%Y年 %m月 %d日 (%a)}",
    "tooltip-format": "<big><b>隻狼: 影逝二度</b></big>\n\n<tt><small>{calendar}</small></tt>\n\n「迷えば、敗れる」\n(Hesitation is defeat)"
  }
}
