{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "small",
    "color": {
      "1": "red",
      "2": "yellow"
    }
  },
  "display": {
    "separator": " ⚔ "
  },
  "modules": [
    {
      "type": "custom",
      "format": "\u001b[1;31m  隻狼: SHADOWS DIE TWICE  \u001b[0m"
    },
    {
      "type": "custom",
      "format": "\u001b[33m  「迷えば、敗れる」 - Hesitation is defeat\u001b[0m"
    },
    "break",
    {
      "type": "os",
      "key": "  Clan (OS)",
      "keyColor": "red"
    },
    {
      "type": "kernel",
      "key": "  Discipline (Kernel)",
      "keyColor": "red"
    },
    {
      "type": "wm",
      "key": "  Dojo (WM)",
      "keyColor": "red"
    },
    {
      "type": "terminal",
      "key": "  Scroll (Terminal)",
      "keyColor": "red"
    },
    {
      "type": "cpu",
      "key": "  Vitality (CPU)",
      "keyColor": "yellow"
    },
    {
      "type": "memory",
      "key": "  Posture (RAM)",
      "keyColor": "yellow"
    },
    {
      "type": "uptime",
      "key": "  Journey (Uptime)",
      "keyColor": "red"
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}
